# Gemini — https://aistudio.google.com/apikey
GOOGLE_GENERATIVE_AI_API_KEY=

# ElevenLabs — https://elevenlabs.io/app/settings/api-keys
ELEVENLABS_API_KEY=
ELEVENLABS_AGENT_ID=

# Google OAuth "Web application" client ID (public; used by the Gmail popup)
NEXT_PUBLIC_GOOGLE_CLIENT_ID=

# Google OAuth client secret (server only). Google Cloud → Clients → your Web client.
GOOGLE_CLIENT_SECRET=

# Encrypts the Gmail session cookie (server only). Generate: openssl rand -base64 32
SESSION_SECRET=
